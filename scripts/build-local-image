#!/bin/sh

set -eu

version=${1:?Uso: build-local-image <version>}
case "$version" in
    *[!A-Za-z0-9._-]*|'')
        echo "ERROR: versión inválida" >&2
        exit 1
        ;;
esac

commit_sha=$(git rev-parse --short=12 HEAD)
build_time=$(date -u +%Y-%m-%dT%H:%M:%SZ)

docker build \
    --build-arg APP_VERSION="$version" \
    --build-arg APP_COMMIT_SHA="$commit_sha" \
    --build-arg APP_BUILD_TIME="$build_time" \
    --tag hospital-st-lucia:local \
    --tag "hospital-st-lucia:$version" \
    .

echo "Build OK: hospital-st-lucia:${version} (${commit_sha}, ${build_time})"
